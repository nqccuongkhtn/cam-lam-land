# ===== Xưởng xử lý dữ liệu quyhoach2025: loại dữ liệu LỚN khỏi git =====
# Giữ trong git: *.dgn (nguồn gốc, khó thay thế), rebuild_qh.py, *.user.js, *.md
# Loại (tái tạo được / rất nặng):
quyhoach2025/**/*.geojson
quyhoach2025/**/*.mbtiles
quyhoach2025/**/*.pmtiles
quyhoach2025/**/*.gpkg
quyhoach2025/**/*.npy
quyhoach2025/**/*.gtp
quyhoach2025/_qh_tile_cu_*/
quyhoach2025/**/tiles/

# ===== Chặn dữ liệu lớn NGOÀI quyhoach2025 =====
# Tile raster (hàng trăm nghìn file nhỏ, tái tạo được từ .dgn/PDF)
_qh_tile_cu_*/
apps/frontend/public/tiles/

# GeoJSON vector quy hoạch bản nháp v2..v6 (mỗi file 20-60 MB, tái tạo được)
# Giữ lại: apps/frontend/public/qh_vector.geojson (bản đang dùng)
apps/frontend/public/qh_vector_v*.geojson
apps/frontend/public/qh_smooth.geojson
apps/frontend/public/qh_fill.geojson

# Ảnh kiểm tra / căn chỉnh + mảng numpy ở thư mục gốc (file tạm khi dò toạ độ)
/*.png
/*.npy
/*.tmp
!camlam-server.png
!chu-giai-loai-dat.png

# Cache Python & thư mục sao lưu cục bộ
__pycache__/
**/__pycache__/
backup/

