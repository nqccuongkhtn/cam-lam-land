{"chang": [{"so": 0, "ten": "Nền: từ ngữ · loại đất · thời hạn · hạn mức", "icon": "🗂️", "mau": "slate", "trongTam": false, "moTa": "Học trước tiên. Chưa nắm từ ngữ và loại đất thì mọi điều sau đọc đều lơ mơ."}, {"so": 1, "ten": "Cấp Giấy chứng nhận", "icon": "📗", "mau": "emerald", "trongTam": true, "moTa": "Bốn trường hợp được xét cấp, ba mốc thời gian, hồ sơ và mẫu giấy."}, {"so": 2, "ten": "Đăng ký biến động", "icon": "🔄", "mau": "sky", "trongTam": true, "moTa": "Trường hợp nào phải đăng ký, cái nào bắt buộc trong 30 ngày, hồ sơ và thời hạn."}, {"so": 3, "ten": "Thu hồi đất", "icon": "🚧", "mau": "rose", "trongTam": true, "moTa": "Vì sao được thu hồi, trình tự, thẩm quyền, trưng dụng đất."}, {"so": 4, "ten": "Bồi thường, hỗ trợ, tái định cư", "icon": "💰", "mau": "amber", "trongTam": true, "moTa": "Điều kiện được bồi thường, bồi thường về đất và tài sản, các khoản hỗ trợ, tái định cư."}, {"so": 5, "ten": "Chuyển mục đích · Tách, hợp thửa", "icon": "🔁", "mau": "orange", "trongTam": false, "moTa": "Các việc làm thay đổi thửa đất, phải xin phép hoặc đủ điều kiện."}, {"so": 6, "ten": "Quyền của người sử dụng đất khi giao dịch", "icon": "🤝", "mau": "violet", "trongTam": false, "moTa": "Một bộ điều kiện dùng chung cho mọi giao dịch."}, {"so": 7, "ten": "Tài chính về đất đai · Giá đất", "icon": "🏷️", "mau": "violet", "trongTam": false, "moTa": "Hai loại giá và các khoản phải nộp."}, {"so": 8, "ten": "Giải quyết tranh chấp · Xử phạt", "icon": "⚖️", "mau": "orange", "trongTam": false, "moTa": "Khi có bất đồng thì đi đâu, theo trình tự nào."}, {"so": 9, "ten": "Quy hoạch · Kỹ thuật, dữ liệu đất đai", "icon": "🗺️", "mau": "teal", "trongTam": false, "moTa": "Phần chuyên môn: quy hoạch, đo đạc, cơ sở dữ liệu, thẩm quyền."}, {"so": 10, "ten": "Hiệu lực · Chuyển tiếp · Các đời luật", "icon": "📅", "mau": "slate", "trongTam": false, "moTa": "Học cuối: điều nào đã bãi bỏ, bị sửa ra sao, hồ sơ vắt qua mốc thì theo luật nào."}], "theoDieu": {"ldd2024:1": [0], "ldd2024:2": [0], "ldd202